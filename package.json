{
  "name": "pais-review",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:abbreviations": "node scripts/check-abbreviations.mjs",
    "session-stats": "node --import tsx scripts/session-stats.mjs",
    "restore-backup": "node --import tsx scripts/restore-backup.mjs",
    "test": "node --import tsx --test tests/*.test.mjs",
    "fetch-sources": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA --import tsx scripts/fetch-sources.mjs",
    "catalogue-sync": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA --import tsx scripts/catalogue-sync.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "diff": "8.0.4",
    "gray-matter": "^4.0.3",
    "next": "^15.5.28",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
